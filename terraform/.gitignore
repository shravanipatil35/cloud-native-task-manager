# Terraform state files
*.tfstate
*.tfstate.*
.terraform/

# Crash logs
crash.log
crash.*.log

# Variable override files (may contain secrets)
*.auto.tfvars
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# SSH keys – NEVER commit private keys
keys/*.pem
keys/*.key

# OS junk
.DS_Store
Thumbs.db
